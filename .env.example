# Copy this file to .env and edit the values before running the server.
# Never commit your real .env file — it is already excluded via .gitignore.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | production
NODE_ENV=development

# Port the server listens on
PORT=3000

# ---------------------------------------------------------------------------
# Security — REQUIRED in production
# ---------------------------------------------------------------------------
# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# There is NO insecure default — the server refuses to start in production
# without a strong value here, and generates a throwaway one (with a warning)
# for local development if you leave this blank.
SESSION_SECRET=

# Set to true only when the app is running behind a reverse proxy that
# terminates HTTPS (nginx, Caddy, a cloud load balancer, etc). This makes
# Express trust the proxy's X-Forwarded-* headers, which is required for
# secure cookies and rate limiting to work correctly behind a proxy.
TRUST_PROXY=false

# Force the "secure" cookie flag on/off. Defaults to true when
# NODE_ENV=production and false otherwise — override only if you know you
# need to (e.g. testing a production build over plain HTTP locally).
# COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Admin account — used ONLY the first time the server starts (i.e. when
# data/shop.db does not exist yet, so the admins table is empty).
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin

# If left blank, a strong random password is generated automatically and
# printed to the console ONCE on first startup — copy it down immediately,
# it is never written to disk. If you set your own value here, it must be
# at least 10 characters and include upper+lower case, a number, and a
# special character, or the server will refuse to start.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Optional override for where the SQLite file lives (absolute or relative
# path). Defaults to ./data/shop.db
# DB_PATH=./data/shop.db
